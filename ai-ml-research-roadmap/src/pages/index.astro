---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HeroPath from '../components/HeroPath.astro';
import RoadmapMap from '../components/RoadmapMap.astro';
import { AbdurRahman_ONE_URL } from '../data/courses';
import { journalTypes, researchGuide } from '../data/research-guide';
import {
  levels,
  phases,
  totalSessions,
  totalModules,
  capstonesOf,
  phaseOfLevel,
} from '../data/levels';

/* One card per ship-it module — the merged RAG level ships two. */
const ships = levels.flatMap((level) =>
  capstonesOf(level).map((capstone) => ({ level, capstone })),
);
const shipLevelCount = levels.filter((level) => capstonesOf(level).length > 0).length;

const projectMeta: Record<number, { domain: string; tags: string[]; summary: string }> = {
  0: {
    domain: 'Scientific Infrastructure',
    tags: ['Reproducibility', 'MLflow / DVC', 'SLURM Shell'],
    summary: 'Modular, object-oriented experiment harness with deterministic seeds, Git commit tracking, automated smoke tests, and resilient checkpointing.',
  },
  1: {
    domain: 'Proposal & Lab Onboarding',
    tags: ['Research Proposal', 'Lab Protocol', 'Literature Scope'],
    summary: 'Formal 3-page research proposal defining hypotheses, threat models, methodology, and compute budgets aligned with institutional lab standards.',
  },
  2: {
    domain: 'Systematic Literature Review',
    tags: ['PRISMA 2020', 'Taxonomy Matrix', 'Bibliometrics'],
    summary: 'Exhaustive literature survey across 50+ papers with PRISMA flow diagrams, methodological taxonomy matrices, and open challenge mapping.',
  },
  3: {
    domain: 'Statistical Rigor',
    tags: ['Hypothesis Testing', 'Bootstrap CI', "Cohen's d / FDR"],
    summary: 'Statistical audit package computing paired non-parametric tests, effect sizes, statistical power, and Benjamini-Hochberg FDR corrections.',
  },
  4: {
    domain: 'Multi-Domain Curation',
    tags: ['Medical & Cyber Data', 'Data Sheets', 'Leakage Audit'],
    summary: 'End-to-end dataset curation and leakage-auditing pipeline across clinical healthcare and cybersecurity network traffic.',
  },
  5: {
    domain: 'Empirical Modeling',
    tags: ['Trees vs. Deep NNs', 'AUROC / AUPRC', 'Wilcoxon Tests'],
    summary: 'Benchmark classical algorithms (XGBoost, LightGBM) against deep networks on equal compute budgets with Wilcoxon signed-rank significance tests.',
  },
  6: {
    domain: 'Relational & Sequence AI',
    tags: ['PyG Graph Networks', 'State Space (Mamba)', 'Long Context'],
    summary: 'Design and validate Graph Neural Networks (GCN/GAT) and modern State Space Models for network threat graphs and long-range sequential sequences.',
  },
  7: {
    domain: 'Generative Modeling',
    tags: ['Diffusion (DDPM)', 'Differential Privacy', 'Clinical Synthesis'],
    summary: 'Train denoising diffusion and flow models to synthesize sensitive clinical and security data under strict Rényi Differential Privacy guarantees.',
  },
  8: {
    domain: 'Ablation & Benchmarking',
    tags: ['Controlled Ablations', 'Statistical Power', 'Conference Tables'],
    summary: 'Execute comprehensive component ablations under compute parity to isolate genuine scientific contributions and produce publication-ready tables.',
  },
  9: {
    domain: 'HPC & Distributed Systems',
    tags: ['FSDP / Megatron', 'MFU Profiling', 'Multi-Node SLURM'],
    summary: 'Implement distributed data and tensor-parallel training across multi-GPU nodes with verified Model FLOPs Utilization (MFU) benchmarking.',
  },
  10: {
    domain: 'Domain Foundation Models',
    tags: ['DAPT / QLoRA', 'Clinical & Cyber Corpora', 'Domain Evaluation'],
    summary: 'Specialize open foundation models via Domain-Adaptive Pre-Training on PubMed or cybersecurity threat corpora, outperforming generic LLMs on expert tasks.',
  },
  11: {
    domain: 'Explainable AI (XAI)',
    tags: ['Mechanistic Circuits', 'Integrated Gradients', 'Trustworthy AI'],
    summary: 'Unpack black-box models using integrated gradients, attention dissection, and causal circuit isolation to meet clinical and regulatory audit standards.',
  },
  12: {
    domain: 'Robustness & Fairness',
    tags: ['AutoAttack / FGSM', 'Disparate Impact', 'Certified Defenses'],
    summary: 'Stress-test models against white-box adversarial perturbations and audit demographic parity to scientifically validate trustworthiness.',
  },
  13: {
    domain: 'Multimodal Research',
    tags: ['Cross-Attention', 'Imaging + Notes', 'Interdisciplinary AI'],
    summary: 'Build a cross-modal research system fusing medical imaging with clinical notes or host logs with threat reports via joint latent representations.',
  },
  15: {
    domain: 'Thesis & Manuscript',
    tags: ['LaTeX Manuscript', 'OpenReview Rebuttal', 'Defense Deck'],
    summary: 'Compile a complete 9-page conference paper draft in LaTeX, author point-by-point reviewer rebuttals, and deliver an oral defense job talk package.',
  },
};

const howItWorks = [
  {
    icon: 'compass',
    title: 'Start where you are',
    body: 'Each level lists what you need to know first. If you already know it, skip ahead.',
  },
  {
    icon: 'layers',
    title: 'Do one level at a time',
    body: 'Each level has a few modules, and most end with a project. Go in order, because each level builds on the last.',
  },
  {
    icon: 'rocket',
    title: 'Finish by building',
    body: "A level is done when you've built its project and can do everything on its outcome list. Watching the videos is not enough.",
  },
];
---

<Base
  title="AI/ML Research Roadmap — From Foundations to Research Career | AbdurRahman"
  description={`A complete ${levels.length}-level AI/ML research roadmap for aspiring computer science researchers: foundations, paper reading, research design, data science, modeling, experiments, publication, thesis defense, interviews, and research careers.`}
  page="home"
  ogImage="/og/default.png"
>
  <!-- ───────────────────────── hero ───────────────────────── -->
  <section class="hero">
    <div class="wrap hero__inner">

      <!-- Eyebrow badge -->
      <div class="hero__eyebrow">
        <span class="hero__pulse-dot" aria-hidden="true"></span>
        <span>Thesis &amp; Research Publication Track</span>
      </div>

      <!-- Big number + headline -->
      <div class="hero__headline-block">
        <span class="hero__big-num">16</span>
        <div class="hero__headline-text">
          <h1 class="hero__title">Levels. One research track.<br><span class="grad-text">From first principles to a career.</span></h1>
          <p class="hero__sub">A complete path for aspiring computer science researchers: learn the foundations, find questions, run defensible experiments, write papers, defend your thesis, and earn your next research role.</p>
        </div>
      </div>

      <!-- Stats row -->
      <div class="hero__stats" role="list" aria-label="Curriculum stats">
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-val">{totalSessions}</span>
          <span class="hero__stat-label">Sessions</span>
        </div>
        <div class="hero__stat-div" aria-hidden="true"></div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-val">{totalModules}</span>
          <span class="hero__stat-label">Modules</span>
        </div>
        <div class="hero__stat-div" aria-hidden="true"></div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-val">{ships.length}</span>
          <span class="hero__stat-label">Capstones</span>
        </div>
        <div class="hero__stat-div" aria-hidden="true"></div>
        <div class="hero__stat" role="listitem">
          <span class="hero__stat-val">{phases.length}</span>
          <span class="hero__stat-label">Phases</span>
        </div>
      </div>

      <!-- CTAs -->
      <div class="hero__ctas">
        <Button href="/level/0/" variant="primary" size="lg" track="hero_start">Start at Level 0</Button>
        <Button href="#map" variant="secondary" size="lg" track="hero_map">View the roadmap</Button>
      </div>

      <!-- Topic chip row -->
      <div class="hero__topics" aria-label="Topics covered">
        {[
          'Classical ML', 'Deep Learning', 'Transformers', 'Graph NNs',
          'Diffusion Models', 'State Space Models', 'XAI', 'Trustworthy AI',
          'Medical Data', 'Cybersecurity', 'Ablation Studies', 'LaTeX Manuscripts',
          'NeurIPS · ICML', 'Thesis Defense',
        ].map(t => <span class="hero__chip">{t}</span>)}
      </div>

    </div>
  </section>

  <!-- ───────────────────────── how it works ───────────────────────── -->
  <section class="section how" id="how">
    <div class="wrap">
      <SectionHeader
        eyebrow="How to use it"
        title="Three simple rules."
      />
      <ol class="how__grid" role="list">
        {
          howItWorks.map((step, i) => (
            <li class="how__item reveal">
              <span class="how__ico"><Icon name={step.icon} size={19} /></span>
              <span class="how__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="how__title">{step.title}</h3>
              <p class="how__body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────────────────── the map ───────────────────────── -->
  <section class="section map-section" id="map">
    <div class="wrap">
      <SectionHeader
        eyebrow="The roadmap"
        title={`All ${levels.length} levels, in order.`}
        subhead={`${levels.length} levels in ${phases.length} phases. Each color is a phase. Click any level to see its modules and project.`}
        class="map-section__head"
      />
      <RoadmapMap />
    </div>
  </section>

  <!-- ───────────────────────── research field guide ───────────────────────── -->
  <section class="section guide" id="field-guide">
    <div class="wrap">
      <SectionHeader
        eyebrow="Researcher's field guide"
        title="Everything around the experiment."
        subhead="The roadmap teaches the craft end to end: how to enter research, read critically, make defensible evidence, publish responsibly, prepare for assessment, and build a career."
        class="guide__head"
      />

      <div class="guide__grid">
        {researchGuide.map((section) => (
          <article class="guide__card reveal" id={section.id}>
            <div class="guide__card-top">
              <span class="guide__icon"><Icon name={section.icon} size={18} /></span>
              <span class="guide__eyebrow">{section.eyebrow}</span>
            </div>
            <h3 class="guide__title">{section.title}</h3>
            <p class="guide__summary">{section.summary}</p>
            <ul class="guide__steps">
              {section.steps.map((step) => <li>{step}</li>)}
            </ul>
            <a class="guide__link" href={section.href}>
              <span>{section.linkLabel}</span>
              <Icon name="arrow-right" size={15} />
            </a>
          </article>
        ))}
      </div>

      <div class="venues">
        <div class="venues__copy">
          <span class="eyebrow">Publication map</span>
          <h2 class="h2">Not every result belongs in the same venue.</h2>
          <p class="lede">Learn the difference between a journal, conference, workshop, preprint, and artifact release before you submit. Venue fit is part of research strategy.</p>
        </div>
        <div class="venues__list">
          {journalTypes.map(([name, description], index) => (
            <div class="venue">
              <span class="venue__number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="venue__name">{name}</h3>
                <p class="venue__description">{description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── 16 projects you'll build ───────────────────────── -->
  <section class="section ships" id="projects">
    <div class="wrap">
      <SectionHeader
        eyebrow="Capstone Projects"
        title={`${ships.length} projects you'll build.`}
      />

      <!-- Stats Strip -->
      <div class="ships__stats" role="region" aria-label="Capstone highlights">
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="microscope" size={16} /></span>
          <span class="ships__stat-num">{ships.length} Capstones</span>
        </div>
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="circle-check" size={16} /></span>
          <span class="ships__stat-num">Reproducible</span>
        </div>
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="database" size={16} /></span>
          <span class="ships__stat-num">Multi-Domain</span>
        </div>
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="badge-check" size={16} /></span>
          <span class="ships__stat-num">Venue-Ready</span>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="ships__filters" role="tablist" aria-label="Filter by phase">
        <button type="button" class="ships__filter-btn is-active" data-filter="all" role="tab" aria-selected="true">All <span class="ships__filter-count">{ships.length}</span></button>
        <button type="button" class="ships__filter-btn" data-filter="foundations" role="tab" aria-selected="false">Foundations <span class="ships__filter-count">4</span></button>
        <button type="button" class="ships__filter-btn" data-filter="retrieval" role="tab" aria-selected="false">Data &amp; modeling <span class="ships__filter-count">3</span></button>
        <button type="button" class="ships__filter-btn" data-filter="agentic" role="tab" aria-selected="false">Generative science <span class="ships__filter-count">3</span></button>
        <button type="button" class="ships__filter-btn" data-filter="trust" role="tab" aria-selected="false">Trustworthy AI <span class="ships__filter-count">3</span></button>
        <button type="button" class="ships__filter-btn" data-filter="production" role="tab" aria-selected="false">Cross-disciplinary <span class="ships__filter-count">1</span></button>
        <button type="button" class="ships__filter-btn" data-filter="frontier-interview" role="tab" aria-selected="false">Publishing &amp; careers <span class="ships__filter-count">1</span></button>
      </div>

      <!-- Simple Project Cards Grid -->
      <ul class="ships__grid" role="list">
        {
          ships.map(({ level, capstone }) => {
            const meta = projectMeta[level.number] || {
              domain: 'Machine Learning Research',
              tags: ['Peer-Reviewed Spec', 'Reproducibility', 'Research Code'],
              summary: '',
            };
            const phase = phaseOfLevel(level.number);
            const cleanName = capstone.name.replace(/^(Capstone Project|Capstone):\s*/i, '');
            const filterGroup = level.phase === 'frontier' ? 'frontier-interview' : level.phase;

            return (
              <li class="ships__item reveal" data-phase={level.phase} data-filter-group={filterGroup}>
                <a
                  href={`/level/${level.number}/#ship`}
                  class="ships__card"
                  data-track="ship_click"
                  data-track-data={String(level.number)}
                >
                  <!-- Level + Phase Row -->
                  <div class="ships__card-head">
                    <span class="ships__lvl-badge">L{level.number}</span>
                    <span class="ships__phase-pill">
                      <Icon name={phase.icon} size={11} />
                      <span>{phase.name}</span>
                    </span>
                  </div>

                  <!-- Title -->
                  <h3 class="ships__card-title">{cleanName}</h3>

                  <!-- Tag Pills -->
                  <div class="ships__card-tags" aria-label="Key deliverables">
                    {meta.tags.map((tag) => (
                      <span class="ships__tag-pill">{tag}</span>
                    ))}
                  </div>

                  <!-- Arrow -->
                  <span class="ships__arrow-wrap" aria-hidden="true">
                    <Icon name="arrow-right" size={14} class="ships__arrow" />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <script>
    function setupShipsFiltering() {
      const filterBtns = document.querySelectorAll('.ships__filter-btn');
      const shipItems = document.querySelectorAll('.ships__item');
      if (!filterBtns.length || !shipItems.length) return;

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-filter') || 'all';

          filterBtns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          shipItems.forEach((item) => {
            const el = item as HTMLElement;
            const group = el.dataset.filterGroup;
            const phase = el.dataset.phase;
            const match = target === 'all' || target === group || target === phase;
            if (match) {
              el.classList.remove('is-hidden');
            } else {
              el.classList.add('is-hidden');
            }
          });
        });
      });
    }

    setupShipsFiltering();
    document.addEventListener('astro:page-load', setupShipsFiltering);
  </script>

  <!-- ───────────────────────── AbdurRahman ───────────────────────── -->
  <section class="section cta">
    <div class="wrap cta__inner">
      <div class="cta__copy">
        <Eyebrow text="AbdurRahman One" />
        <h2 class="h2">Build the evidence. Then take it to the world.</h2>
        <p class="lede">
          The roadmap gives you the sequence and research practice. Use the linked AbdurRahman One
          courses to deepen each skill, then turn your work into papers, a thesis, interviews, and
          a durable research portfolio.
        </p>
        <div class="cta__buttons">
          <Button
            href={AbdurRahman_ONE_URL}
            variant="primary"
            size="lg"
            external
            track="AbdurRahman_cta_click"
            trackData="home_footer"
          >
            Explore AbdurRahman One
          </Button>
          <Button href="/level/0/" variant="secondary" size="lg" track="cta_level0">
            Start at Level 0
          </Button>
        </div>
      </div>

      <ul class="cta__phases" role="list">
        {
          phases.map((p) => (
            <li class="cta__phase" data-phase={p.id}>
              <Icon name={p.icon} size={15} />
              <span class="cta__phase-name">{p.name}</span>
              <span class="cta__phase-range">
                {p.levels.length === 1
                  ? `L${p.levels[0]}`
                  : `L${p.levels[0]}–${p.levels[p.levels.length - 1]}`}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    padding-block: 80px 64px;
    background-color: var(--cx-white);
    background-image:
      radial-gradient(ellipse 70% 55% at 50% -5%, rgba(37, 99, 235, 0.09), transparent 70%),
      radial-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px);
    background-size: 100% 100%, 26px 26px;
    border-bottom: 1px solid var(--cx-border);
    overflow: hidden;
  }
  :global([data-theme='dark']) .hero {
    background-color: #040814;
    background-image:
      radial-gradient(ellipse 70% 55% at 50% -5%, rgba(59, 130, 246, 0.14), transparent 70%),
      radial-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 100% 100%, 26px 26px;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  /* Eyebrow */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: var(--cx-r-pill);
    background: var(--p-blue-bg);
    border: 1px solid var(--p-blue-br);
    color: var(--p-blue-ac);
    font-family: var(--cx-font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero__pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: heroPulse 2s infinite;
    flex: none;
  }
  @keyframes heroPulse {
    0%   { box-shadow: 0 0 0 0   rgba(16, 185, 129, 0.7); }
    70%  { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);   }
    100% { box-shadow: 0 0 0 0   rgba(16, 185, 129, 0);   }
  }

  /* Big number + headline */
  .hero__headline-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  @media (min-width: 760px) {
    .hero__headline-block {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 28px;
    }
  }
  .hero__big-num {
    font-family: var(--cx-font-display);
    font-size: clamp(80px, 14vw, 140px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--cx-ink);
    flex: none;
    /* subtle outline style */
    -webkit-text-stroke: 2px var(--cx-border-2);
    color: transparent;
    background: var(--cx-title-grad-sm);
    -webkit-background-clip: text;
    background-clip: text;
  }
  :global([data-theme='dark']) .hero__big-num {
    -webkit-text-stroke: 2px rgba(255,255,255,0.12);
  }
  .hero__headline-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 600px;
  }
  .hero__title {
    margin: 0;
    font-size: clamp(26px, 4vw, 48px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--cx-ink);
    text-wrap: balance;
  }
  .hero__sub {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--cx-g600);
    margin: 0;
    max-width: 54ch;
  }

  /* Stats row */
  .hero__stats {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--cx-surface);
    border: 1px solid var(--cx-border);
    border-radius: var(--cx-r-pill);
    padding: 0 4px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 28px;
    gap: 2px;
  }
  .hero__stat-val {
    font-family: var(--cx-font-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--cx-ink);
    line-height: 1;
  }
  .hero__stat-label {
    font-family: var(--cx-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cx-g500);
  }
  .hero__stat-div {
    width: 1px;
    height: 32px;
    background: var(--cx-border);
    flex: none;
  }

  /* CTAs */
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  @media (max-width: 440px) {
    .hero__ctas { flex-direction: column; width: 100%; }
    .hero__ctas :global(a), .hero__ctas :global(button) { width: 100%; justify-content: center; }
  }

  /* Topic chips */
  .hero__topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 7px;
    max-width: 720px;
    padding-top: 4px;
  }
  .hero__chip {
    font-family: var(--cx-font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 4px 11px;
    border-radius: var(--cx-r-pill);
    background: var(--cx-surface);
    border: 1px solid var(--cx-border);
    color: var(--cx-g600);
    white-space: nowrap;
    transition: border-color 0.16s ease, color 0.16s ease;
  }
  .hero__chip:hover {
    border-color: var(--cx-brand);
    color: var(--cx-brand);
  }
  :global([data-theme='dark']) .hero__chip {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.09);
  }

  /* ---------- how ---------- */
  .how { padding-block: 64px; }
  .how__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) { .how__grid { grid-template-columns: repeat(3, 1fr); gap: 22px; } }

  .how__item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'ico n' 'title title' 'body body';
    gap: 12px 14px;
    padding: 24px;
    background: var(--cx-surface);
