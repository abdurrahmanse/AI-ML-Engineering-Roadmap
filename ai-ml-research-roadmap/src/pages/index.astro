---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HeroPath from '../components/HeroPath.astro';
import RoadmapMap from '../components/RoadmapMap.astro';
import { AbdurRahman_ONE_URL } from '../data/courses';
import {
  levels,
  phases,
  totalSessions,
  totalModules,
  capstonesOf,
  phaseOfLevel,
} from '../data/levels';

/* One card per ship-it module — the merged RAG level ships two. */
const ships = levels.flatMap((level) =>
  capstonesOf(level).map((capstone) => ({ level, capstone })),
);
const shipLevelCount = levels.filter((level) => capstonesOf(level).length > 0).length;

const projectMeta: Record<number, { domain: string; tags: string[]; summary: string }> = {
  0: {
    domain: 'Scientific Infrastructure',
    tags: ['Reproducibility', 'MLflow / DVC', 'SLURM Shell'],
    summary: 'Modular, object-oriented experiment harness with deterministic seeds, Git commit tracking, automated smoke tests, and resilient checkpointing.',
  },
  1: {
    domain: 'Proposal & Lab Onboarding',
    tags: ['Research Proposal', 'Lab Protocol', 'Literature Scope'],
    summary: 'Formal 3-page research proposal defining hypotheses, threat models, methodology, and compute budgets aligned with institutional lab standards.',
  },
  2: {
    domain: 'Systematic Literature Review',
    tags: ['PRISMA 2020', 'Taxonomy Matrix', 'Bibliometrics'],
    summary: 'Exhaustive literature survey across 50+ papers with PRISMA flow diagrams, methodological taxonomy matrices, and open challenge mapping.',
  },
  3: {
    domain: 'Statistical Rigor',
    tags: ['Hypothesis Testing', 'Bootstrap CI', "Cohen's d / FDR"],
    summary: 'Statistical audit package computing paired non-parametric tests, effect sizes, statistical power, and Benjamini-Hochberg FDR corrections.',
  },
  4: {
    domain: 'Multi-Domain Curation',
    tags: ['Medical & Cyber Data', 'Data Sheets', 'Leakage Audit'],
    summary: 'End-to-end dataset curation and leakage-auditing pipeline across clinical healthcare and cybersecurity network traffic.',
  },
  5: {
    domain: 'Empirical Modeling',
    tags: ['Trees vs. Deep NNs', 'AUROC / AUPRC', 'Wilcoxon Tests'],
    summary: 'Benchmark classical algorithms (XGBoost, LightGBM) against deep networks on equal compute budgets with Wilcoxon signed-rank significance tests.',
  },
  6: {
    domain: 'Relational & Sequence AI',
    tags: ['PyG Graph Networks', 'State Space (Mamba)', 'Long Context'],
    summary: 'Design and validate Graph Neural Networks (GCN/GAT) and modern State Space Models for network threat graphs and long-range sequential sequences.',
  },
  7: {
    domain: 'Generative Modeling',
    tags: ['Diffusion (DDPM)', 'Differential Privacy', 'Clinical Synthesis'],
    summary: 'Train denoising diffusion and flow models to synthesize sensitive clinical and security data under strict Rényi Differential Privacy guarantees.',
  },
  8: {
    domain: 'Ablation & Benchmarking',
    tags: ['Controlled Ablations', 'Statistical Power', 'Conference Tables'],
    summary: 'Execute comprehensive component ablations under compute parity to isolate genuine scientific contributions and produce publication-ready tables.',
  },
  9: {
    domain: 'HPC & Distributed Systems',
    tags: ['FSDP / Megatron', 'MFU Profiling', 'Multi-Node SLURM'],
    summary: 'Implement distributed data and tensor-parallel training across multi-GPU nodes with verified Model FLOPs Utilization (MFU) benchmarking.',
  },
  10: {
    domain: 'Domain Foundation Models',
    tags: ['DAPT / QLoRA', 'Clinical & Cyber Corpora', 'Domain Evaluation'],
    summary: 'Specialize open foundation models via Domain-Adaptive Pre-Training on PubMed or cybersecurity threat corpora, outperforming generic LLMs on expert tasks.',
  },
  11: {
    domain: 'Explainable AI (XAI)',
    tags: ['Mechanistic Circuits', 'Integrated Gradients', 'Trustworthy AI'],
    summary: 'Unpack black-box models using integrated gradients, attention dissection, and causal circuit isolation to meet clinical and regulatory audit standards.',
  },
  12: {
    domain: 'Robustness & Fairness',
    tags: ['AutoAttack / FGSM', 'Disparate Impact', 'Certified Defenses'],
    summary: 'Stress-test models against white-box adversarial perturbations and audit demographic parity to scientifically validate trustworthiness.',
  },
  13: {
    domain: 'Multimodal Research',
    tags: ['Cross-Attention', 'Imaging + Notes', 'Interdisciplinary AI'],
    summary: 'Build a cross-modal research system fusing medical imaging with clinical notes or host logs with threat reports via joint latent representations.',
  },
  15: {
    domain: 'Thesis & Manuscript',
    tags: ['LaTeX Manuscript', 'OpenReview Rebuttal', 'Defense Deck'],
    summary: 'Compile a complete 9-page conference paper draft in LaTeX, author point-by-point reviewer rebuttals, and deliver an oral defense job talk package.',
  },
};

const howItWorks = [
  {
    icon: 'compass',
    title: 'Start where you are',
    body: 'Each level lists what you need to know first. If you already know it, skip ahead.',
  },
  {
    icon: 'layers',
    title: 'Do one level at a time',
    body: 'Each level has a few modules, and most end with a project. Go in order, because each level builds on the last.',
  },
  {
    icon: 'rocket',
    title: 'Finish by building',
    body: "A level is done when you've built its project and can do everything on its outcome list. Watching the videos is not enough.",
  },
];
---

<Base
  title="Thesis & Research Publication Track — AI/ML Research Roadmap | AbdurRahman"
  description={`A comprehensive ${levels.length}-level Thesis & Research Publication Track: train models from basics to advanced, explore domain datasets (medical, cybersecurity, science), master Explainable AI (XAI) and Trustworthy AI, conduct controlled ablations, defend your thesis, and publish in premier journals and conferences.`}
  page="home"
  ogImage="/og/default.png"
>
  <!-- ───────────────────────── hero ───────────────────────── -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <Eyebrow text="Thesis & Research Publication Track" />
        <h1 class="h1 hero__title">
          Sixteen levels from <span class="grad-text">research foundations</span> to Principal Research Scientist.
        </h1>
        <p class="lede hero__lede">
          The definitive Thesis & Research Publication Track: an end-to-end AI/ML research roadmap covering extensive model training from basics to advanced (classical ML, 2D/3D CNNs, GNNs, Transformers, Diffusion, State Space Models), multi-domain datasets (healthcare, cybersecurity, science), Explainable AI (XAI), Trustworthy AI, rigorous benchmarking, thesis preparation, and publishing in premier journals and conferences.
        </p>

        <div class="hero__ctas">
          <Button href="#map" variant="primary" size="lg" icon="chevrons-down" track="hero_cta_map">
            See the Roadmap
          </Button>
          <Button href="#how" variant="secondary" size="lg" track="hero_cta_start">
            How to use it
          </Button>
        </div>
      </div>

      <div class="hero__visual">
        <HeroPath />
      </div>
    </div>
  </section>

  <!-- ───────────────────────── how it works ───────────────────────── -->
  <section class="section how" id="how">
    <div class="wrap">
      <SectionHeader
        eyebrow="How to use it"
        title="Three simple rules."
      />
      <ol class="how__grid" role="list">
        {
          howItWorks.map((step, i) => (
            <li class="how__item reveal">
              <span class="how__ico"><Icon name={step.icon} size={19} /></span>
              <span class="how__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="how__title">{step.title}</h3>
              <p class="how__body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────────────────── the map ───────────────────────── -->
  <section class="section map-section" id="map">
    <div class="wrap">
      <SectionHeader
        eyebrow="The roadmap"
        title={`All ${levels.length} levels, in order.`}
        subhead={`${levels.length} levels in ${phases.length} phases. Each color is a phase. Click any level to see its modules and project.`}
        class="map-section__head"
      />
      <RoadmapMap />
    </div>
  </section>

  <!-- ───────────────────────── 15 projects you'll build ───────────────────────── -->
  <section class="section ships" id="projects">
    <div class="wrap">
      <SectionHeader
        eyebrow="Academic Capstones & Research Deliverables"
        title={`${ships.length} projects you'll build.`}
        subhead="Every level culminates in an empirical research deliverable. From automated reproducible pipelines and clinical benchmarks to mechanistic interpretability suites and full conference rebuttal packages, these 15 projects form the backbone of your thesis and publication portfolio."
      />

      <!-- Research Quality Standards Banner -->
      <div class="ships__stats" role="region" aria-label="Research Capstone Highlights">
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="microscope" size={18} /></span>
          <div class="ships__stat-info">
            <span class="ships__stat-num">15 Capstones</span>
            <span class="ships__stat-desc">End-to-end scientific implementations</span>
          </div>
        </div>
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="circle-check" size={18} /></span>
          <div class="ships__stat-info">
            <span class="ships__stat-num">100% Reproducible</span>
            <span class="ships__stat-desc">Deterministic seeds & checkpoint tracking</span>
          </div>
        </div>
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="database" size={18} /></span>
          <div class="ships__stat-info">
            <span class="ships__stat-num">Multi-Domain</span>
            <span class="ships__stat-desc">Clinical, cyber & scientific corpora</span>
          </div>
        </div>
        <div class="ships__stat">
          <span class="ships__stat-ico"><Icon name="badge-check" size={18} /></span>
          <div class="ships__stat-info">
            <span class="ships__stat-num">Venue Standard</span>
            <span class="ships__stat-desc">NeurIPS, ICML, Nature & IEEE aligned</span>
          </div>
        </div>
      </div>

      <!-- Interactive Phase Filter Bar -->
      <div class="ships__filters" role="tablist" aria-label="Filter projects by research phase">
        <button type="button" class="ships__filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
          All Projects <span class="ships__filter-count">15</span>
        </button>
        <button type="button" class="ships__filter-btn" data-filter="foundations" role="tab" aria-selected="false">
          Foundations <span class="ships__filter-count">4</span>
        </button>
        <button type="button" class="ships__filter-btn" data-filter="retrieval" role="tab" aria-selected="false">
          Data & Curation <span class="ships__filter-count">1</span>
        </button>
        <button type="button" class="ships__filter-btn" data-filter="agentic" role="tab" aria-selected="false">
          Core Modeling <span class="ships__filter-count">2</span>
        </button>
        <button type="button" class="ships__filter-btn" data-filter="trust" role="tab" aria-selected="false">
          Generative & Trust <span class="ships__filter-count">2</span>
        </button>
        <button type="button" class="ships__filter-btn" data-filter="production" role="tab" aria-selected="false">
          HPC & Scale <span class="ships__filter-count">3</span>
        </button>
        <button type="button" class="ships__filter-btn" data-filter="frontier-interview" role="tab" aria-selected="false">
          Frontier & Manuscript <span class="ships__filter-count">3</span>
        </button>
      </div>

      <!-- Redesigned High-Impact Project Grid -->
      <ul class="ships__grid" role="list">
        {
          ships.map(({ level, capstone }) => {
            const meta = projectMeta[level.number] || {
              domain: 'Machine Learning Research',
              tags: ['Peer-Reviewed Spec', 'Reproducibility', 'Research Code'],
              summary: capstone.outcome || 'Design and scientifically validate research models with empirical rigor.',
            };
            const phase = phaseOfLevel(level.number);
            const cleanName = capstone.name.replace(/^(Capstone Project|Capstone):\s*/i, '');
            const filterGroup = (level.phase === 'frontier' || level.phase === 'interview') ? 'frontier-interview' : level.phase;

            return (
              <li class="ships__item reveal" data-phase={level.phase} data-filter-group={filterGroup}>
                <a
                  href={`/level/${level.number}/#ship`}
                  class="ships__card"
                  data-track="ship_click"
                  data-track-data={String(level.number)}
                >
                  <!-- Card Header -->
                  <div class="ships__card-head">
                    <div class="ships__card-pills">
                      <span class="ships__lvl-badge">LEVEL {level.number}</span>
                      <span class="ships__phase-pill">
                        <Icon name={phase.icon} size={12} />
                        <span>{phase.name}</span>
                      </span>
                    </div>
                    <span class="ships__domain-tag">{meta.domain}</span>
                  </div>

                  <!-- Project Title -->
                  <h3 class="ships__card-title">
                    {cleanName}
                  </h3>

                  <!-- Project Abstract / Research Summary -->
                  <p class="ships__card-desc">
                    {meta.summary}
                  </p>

                  <!-- Deliverables / Tags -->
                  <div class="ships__card-tags" aria-label="Key deliverables">
                    {meta.tags.map((tag) => (
                      <span class="ships__tag-pill">{tag}</span>
                    ))}
                  </div>

                  <!-- Card Footer / Link Action -->
                  <div class="ships__card-foot">
                    <span class="ships__action-cta">
                      <span>Inspect Research Capstone</span>
                      <Icon name="arrow-right" size={14} class="ships__arrow" />
                    </span>
                    <span class="ships__sessions-badge">
                      {level.totalSessions} sessions
                    </span>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <script>
    function setupShipsFiltering() {
      const filterBtns = document.querySelectorAll('.ships__filter-btn');
      const shipItems = document.querySelectorAll('.ships__item');
      if (!filterBtns.length || !shipItems.length) return;

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-filter') || 'all';

          filterBtns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');

          shipItems.forEach((item) => {
            const el = item as HTMLElement;
            const group = el.dataset.filterGroup;
            const phase = el.dataset.phase;
            const match = target === 'all' || target === group || target === phase;
            if (match) {
              el.classList.remove('is-hidden');
            } else {
              el.classList.add('is-hidden');
            }
          });
        });
      });
    }

    setupShipsFiltering();
    document.addEventListener('astro:page-load', setupShipsFiltering);
  </script>

  <!-- ───────────────────────── AbdurRahman ───────────────────────── -->
  <section class="section cta">
    <div class="wrap cta__inner">
      <div class="cta__copy">
        <Eyebrow text="AbdurRahman One" />
        <h2 class="h2">The roadmap is free. Learn it on AbdurRahman One.</h2>
        <p class="lede">
          Most levels have matching courses on AbdurRahman One. Use the roadmap to decide what to
          learn next, and AbdurRahman One to learn it.
        </p>
        <div class="cta__buttons">
          <Button
            href={AbdurRahman_ONE_URL}
            variant="primary"
            size="lg"
            external
            track="AbdurRahman_cta_click"
            trackData="home_footer"
          >
            Explore AbdurRahman One
          </Button>
          <Button href="/level/0/" variant="secondary" size="lg" track="cta_level0">
            Start at Level 0
          </Button>
        </div>
      </div>

      <ul class="cta__phases" role="list">
        {
          phases.map((p) => (
            <li class="cta__phase" data-phase={p.id}>
              <Icon name={p.icon} size={15} />
              <span class="cta__phase-name">{p.name}</span>
              <span class="cta__phase-range">
                {p.levels.length === 1
                  ? `L${p.levels[0]}`
                  : `L${p.levels[0]}–${p.levels[p.levels.length - 1]}`}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-block: 64px 44px;
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(37, 99, 235, 0.08), transparent 75%),
      linear-gradient(180deg, var(--cx-violet-bg) 0%, var(--cx-white) 85%);
    border-bottom: 1px solid var(--cx-border);
    position: relative;
  }
  @media (min-width: 900px) { .hero { padding-block: 88px 60px; } }
  [data-theme='dark'] .hero {
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(59, 130, 246, 0.15), transparent 75%),
      linear-gradient(180deg, var(--cx-violet-bg) 0%, var(--cx-white) 85%);
  }

  .hero__grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  @media (min-width: 980px) {
    .hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr); gap: 56px; }
  }

  .hero__copy { display: flex; flex-direction: column; gap: 20px; }
  .hero__title { margin-top: 4px; font-size: clamp(28px, 5vw, 56px); max-width: 17ch; }
  @media (min-width: 1180px) { .hero__title { font-size: 60px; max-width: 17ch; } }

  .hero__lede { max-width: 54ch; }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  @media (max-width: 440px) {
    .hero__ctas { flex-direction: column; width: 100%; }
    .hero__ctas :global(a),
    .hero__ctas :global(button) { width: 100%; justify-content: center; }
  }

  .hero__visual { min-width: 0; }

  /* ---------- how ---------- */
  .how { padding-block: 64px; }
  .how__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) { .how__grid { grid-template-columns: repeat(3, 1fr); gap: 22px; } }

  .how__item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'ico n' 'title title' 'body body';
    gap: 12px 14px;
    padding: 24px;
    background: var(--cx-surface);
    border: 1px solid var(--cx-border);
    border-radius: var(--cx-r-card);
    box-shadow: var(--cx-shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .how__item:hover {
    border-color: var(--cx-border-2);
    box-shadow: var(--cx-shadow-card-hover);
    transform: translateY(-2px);
  }
  .how__ico {
    grid-area: ico;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--p-blue-bg);
    border: 1px solid var(--p-blue-br);
    color: var(--p-blue-ac);
  }
  .how__n {
    grid-area: n;
    align-self: center;
    justify-self: end;
    font-family: var(--cx-font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--cx-g500);
  }
  .how__title {
    grid-area: title;
    font-size: 19px;
    margin-top: 4px;
    background: var(--cx-title-grad-sm);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .how__body { grid-area: body; font-size: 14.5px; line-height: 1.6; color: var(--cx-g600); }

  /* ---------- map ---------- */
  .map-section { background: var(--cx-white); padding-top: 24px; scroll-margin-top: 80px; }
  .map-section__head { margin-bottom: 34px; max-width: 720px; }

  /* ---------- 15 projects you'll build ---------- */
  .ships {
    background: var(--cx-gray);
    border-block: 1px solid var(--cx-border);
    padding-block: 72px;
  }
  [data-theme='dark'] .ships {
    background: #090e1a;
  }

  /* Research Quality Standards Banner */
  .ships__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 32px 0 28px;
  }
  @media (min-width: 580px) {
    .ships__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }
  @media (min-width: 980px) {
    .ships__stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  .ships__stat {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: var(--cx-surface);
    border: 1px solid var(--cx-border);
    border-radius: var(--cx-r-card-sm);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .ships__stat:hover {
    border-color: var(--cx-brand);
    transform: translateY(-2px);
  }
  .ships__stat-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--p-blue-bg);
    border: 1px solid var(--p-blue-br);
    color: var(--p-blue-ac);
    flex: none;
  }
  .ships__stat-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .ships__stat-num {
    font-family: var(--cx-font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--cx-ink);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .ships__stat-desc {
    font-size: 12px;
    color: var(--cx-g600);
    line-height: 1.35;
  }

  /* Interactive Phase Filter Pills */
  .ships__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
  }
  .ships__filter-btn {
    appearance: none;
    background: var(--cx-surface);
    border: 1px solid var(--cx-border);
    border-radius: var(--cx-r-pill);
    padding: 7px 15px;
    font-family: var(--cx-font-display);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--cx-g700);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: all 0.18s ease;
    user-select: none;
  }
  .ships__filter-btn:hover {
    border-color: var(--cx-brand);
    color: var(--cx-ink);
    background: var(--cx-white);
  }
  .ships__filter-btn.is-active {
    background: var(--cx-ink);
    color: #ffffff;
    border-color: var(--cx-ink);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
  }
  [data-theme='dark'] .ships__filter-btn.is-active {
    background: var(--cx-brand);
    border-color: var(--cx-brand);
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(59, 130, 246, 0.35);
  }
  .ships__filter-count {
    font-family: var(--cx-font-mono);
    font-size: 11px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    color: inherit;
    line-height: 1.3;
  }
  .ships__filter-btn.is-active .ships__filter-count {
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }

  /* Redesigned Project Cards Grid */
  .ships__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .ships__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  @media (min-width: 1040px) {
    .ships__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
  }

  .ships__item {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .ships__item.is-hidden {
    display: none !important;
  }

  .ships__card {
    display: flex;
    flex-direction: column;
    height: 100%;
