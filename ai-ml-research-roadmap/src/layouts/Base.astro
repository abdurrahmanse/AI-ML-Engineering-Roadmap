---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Page identifier for analytics. */
  page: string;
  levelNumber?: number;
  /** Path to the share image, relative to the site root. */
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  page,
  levelNumber,
  ogImage = "/og/default.png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const siteName = "Thesis & Research Publication Track · AbdurRahman";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#2563eb" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl.href} />

    <!-- Anti-FOUC: apply stored/system theme before first paint -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("cxr-theme");
        } catch (e) {}
        var theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- Fonts: preconnect + display=swap for high-performance scholarly typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,600&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <slot name="head" />
  </head>

  <body
    data-page={page}
    data-level-number={levelNumber !== undefined
      ? String(levelNumber)
      : undefined}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot name="subnav" />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
